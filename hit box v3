local uiName = "HitboxCoreBypassSuiteV8"

local function cleanOldUI(parent)
    if parent and parent:FindFirstChild(uiName) then
        pcall(function() parent[uiName]:Destroy() end)
    end
end

cleanOldUI(CoreGui)
cleanOldUI(LocalPlayer:FindFirstChild("PlayerGui"))
if game:GetService("GuiService") and game:GetService("GuiService"):FindFirstChild("RobloxGui") then
    cleanOldUI(game:GetService("GuiService").RobloxGui)
end
