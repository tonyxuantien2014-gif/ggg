local locked, aiming = nil, false
local smoothPos, smoothVel = nil, Vector3.zero

local rayParams = RaycastParams.new()
pcall(function() rayParams.FilterType = Enum.RaycastFilterType.Exclude end)

local function getChar(p) return p and p.Character end
local function getHum(p)
    local c = getChar(p); return c and c:FindFirstChildOfClass("Humanoid")
end
local function getPart(p)
    local c = getChar(p)
    if not c then return nil end
    return c:FindFirstChild(cfg.AimPart) or c:FindFirstChild("Head") or c:FindFirstChild("HumanoidRootPart")
end
local function gameUsesTeams()
    for _, p in ipairs(Players:GetPlayers()) do if p.Team then return true end end
    return false
end
local function isTeammate(p)
    if not cfg.IgnoreTeam then return false end
    if p == LP then return true end
    if LP.Team and p.Team and p.Team == LP.Team then return true end
    if gameUsesTeams() and LP.TeamColor and p.TeamColor == LP.TeamColor then return true end
    return false
end
local function hasLOS(part)
    if not cfg.WallCheck then return true end
    rayParams.FilterDescendantsInstances = {LP.Character or LP, part.Parent}
    local o = Cam.CFrame.Position
    return WS:Raycast(o, part.Position - o, rayParams) == nil
end
local function validTarget(p)
    if not p or not p.Parent or p == LP then return false end
    local h = getHum(p)
    if not h or h.Health <= 0 then return false end
    local part = getPart(p)
    if not part then return false end
    if (part.Position - Cam.CFrame.Position).Magnitude > cfg.MaxDist then return false end
    return true
end
local function acquire()
    local best, bestD = nil, math.huge
    local mp = UIS:GetMouseLocation()
    for _, p in ipairs(Players:GetPlayers()) do
        if validTarget(p) and not isTeammate(p) then
            local part = getPart(p)
            if part then
                local sp, on = Cam:WorldToViewportPoint(part.Position)
                if on then
                    local d = (Vector2.new(sp.X, sp.Y) - mp).Magnitude
                    if d <= cfg.FOV * 0.5 and d < bestD and hasLOS(part) then best, bestD = p, d end
                end
            end
        end
    end
    return best
end
local function resetLock()
    locked, aiming = nil, false
    smoothPos, smoothVel = nil, Vector3.zero
end

local function aimStep(dt)
    if not cfg.AimEnabled then aiming = false return end
    if locked and not validTarget(locked) then resetLock() end
    if not locked then locked = acquire() end
    if not locked then
        aiming = false; smoothPos, smoothVel = nil, Vector3.zero; return
    end
    local part = getPart(locked)
    if not part then resetLock() return end
    aiming = true

    smoothVel = smoothVel:Lerp(part.AssemblyLinearVelocity, math.clamp(dt * 20, 0, 1))
    local aimPoint = part.Position + smoothVel * (cfg.Predict * 0.02)
    local origin = Cam.CFrame.Position

    if not smoothPos then
        smoothPos = aimPoint
        Cam.CFrame = CFrame.new(origin, aimPoint)
        return
    end

    local alpha = cfg.StrongLock and math.clamp(dt * cfg.LockBite, 0, 1)
        or math.clamp(dt * (cfg.LockBite * 0.3), 0.02, 1)

    if (smoothPos - aimPoint).Magnitude > 20 then
        smoothPos = aimPoint; alpha = 1
    else
        smoothPos = smoothPos:Lerp(aimPoint, alpha)
    end
    Cam.CFrame = CFrame.new(origin, smoothPos)
end

pcall(function() RunService:UnbindFromRenderStep("AimEspStep") end)
if not pcall(function()
    RunService:BindToRenderStep("AimEspStep", Enum.RenderPriority.Camera.Value + 10, aimStep)
end) then
    RunService.RenderStepped:Connect(aimStep)
end

task.spawn(function()
    while task.wait(cfg.FireDelay) do
        if cfg.AutoFire and cfg.AimEnabled and locked and aiming then
            local part = getPart(locked)
            if part and (not cfg.FireVisible or hasLOS(part)) then
                local sp, on = Cam:WorldToViewportPoint(part.Position)
                if on and (Vector2.new(sp.X, sp.Y) - UIS:GetMouseLocation()).Magnitude <= cfg.FireTol * 2 then
                    pcall(function() VU:ClickButton1(Vector2.new(sp.X, sp.Y)) end)
                end
            end
        end
    end
end)

