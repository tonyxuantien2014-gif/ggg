local fovCircle = Drawing.new("Circle")
fovCircle.Thickness = 1.5; fovCircle.NumSides = 64
fovCircle.Filled = false; fovCircle.Transparency = 0.55; fovCircle.Color = C_ACC

local espCache = {}
local function destroyESP(p)
    local c = espCache[p]; if not c then return end
    for _, o in pairs(c) do pcall(function() o:Remove() end) end
    espCache[p] = nil
end
local function createESP()
    local c = {}
    c.box  = Drawing.new("Square"); c.box.Thickness = 1.3; c.box.Filled = false; c.box.Color = C_ACC
    c.hpBg = Drawing.new("Square"); c.hpBg.Filled = true; c.hpBg.Color = Color3.fromRGB(22,22,26)
    c.hp   = Drawing.new("Square"); c.hp.Filled = true;  c.hp.Color = C_ACC
    c.name = Drawing.new("Text"); c.name.Size = 13; c.name.Center = true; c.name.Outline = true; c.name.Color = Color3.new(1,1,1)
    c.dist = Drawing.new("Text"); c.dist.Size = 12; c.dist.Center = true; c.dist.Outline = true; c.dist.Color = C_ACC
    return c
end

RunService.RenderStepped:Connect(function()
    if cfg.AimEnabled and cfg.FOVCircle then
        local mp = UIS:GetMouseLocation()
        fovCircle.Position = mp
        fovCircle.Radius = cfg.FOV * 0.5
        fovCircle.Color = locked and C_ACC or C_BLUE
        fovCircle.Visible = true
    else
        fovCircle.Visible = false
    end

    for p in pairs(espCache) do if not p.Parent or not p.Character then destroyESP(p) end end
    if not cfg.ESP then
        for p in pairs(espCache) do destroyESP(p) end
        return
    end

    for _, p in ipairs(Players:GetPlayers()) do
        if p == LP then destroyESP(p) else
            local char, hum = p.Character, getHum(p)
            local root = char and char:FindFirstChild("HumanoidRootPart")
            local head = char and char:FindFirstChild("Head")
            local d = root and (root.Position - Cam.CFrame.Position).Magnitude or 0
            local show = char and hum and hum.Health > 0 and d <= cfg.ESPMaxDist
                and (cfg.ESPTeam or not isTeammate(p))
            if show and root and head then
                local hPos, hOn = Cam:WorldToViewportPoint(head.Position)
                local rPos, rOn = Cam:WorldToViewportPoint(root.Position)
                if hOn and rOn then
                    local h = math.abs(rPos.Y - hPos.Y) * 2.2
                    local w = h * 0.55
                    local x, y = hPos.X - w * 0.5, hPos.Y - h * 0.28
                    local c = espCache[p] or createESP()
                    espCache[p] = c
                    c.box.Visible = cfg.ESPBox
                    c.box.Size = Vector2.new(w, h)
                    c.box.Position = Vector2.new(x, y)
                    c.box.Color = (p == locked) and C_RED or C_ACC
                    local r = math.clamp(hum.Health / math.max(hum.MaxHealth, 1), 0, 1)
                    c.hpBg.Visible = cfg.ESPHealth
                    c.hpBg.Size = Vector2.new(3, h)
                    c.hpBg.Position = Vector2.new(x - 6, y)
                    c.hp.Visible = cfg.ESPHealth
                    c.hp.Size = Vector2.new(3, h * r)
                    c.hp.Position = Vector2.new(x - 6, y + h * (1 - r))
                    c.hp.Color = Color3.fromRGB(255 * (1 - r) + 30, 210 * r + 40, 70)
                    c.name.Visible = cfg.ESPName
                    c.name.Text = p.Name
                    c.name.Position = Vector2.new(hPos.X, y - 17)
                    c.dist.Visible = cfg.ESPDist
                    c.dist.Text = string.format("[%d]", math.floor(d))
                    c.dist.Position = Vector2.new(hPos.X, y + h + 2)
                else
                    local c = espCache[p]
                    if c then for _, o in pairs(c) do o.Visible = false end end
                end
            else
                local c = espCache[p]
                if c then for _, o in pairs(c) do o.Visible = false end end
            end
        end
    end
end)

