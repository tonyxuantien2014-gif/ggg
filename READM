local hookedHums = {}

local function hookHum(hum)
    if not hum or hookedHums[hum] then return end
    hookedHums[hum] = true
    hum:GetPropertyChangedSignal("WalkSpeed"):Connect(function()
        if cfg.SpeedOn and math.abs(hum.WalkSpeed - cfg.Speed) > 0.1 then hum.WalkSpeed = cfg.Speed end
    end)
    hum:GetPropertyChangedSignal("JumpPower"):Connect(function()
        if cfg.JumpOn and math.abs(hum.JumpPower - cfg.Jump) > 0.1 then hum.JumpPower = cfg.Jump end
    end)
    hum:GetPropertyChangedSignal("UseJumpPower"):Connect(function()
        if cfg.JumpOn and not hum.UseJumpPower then hum.UseJumpPower = true end
    end)
end

local function bindCharacter()
    local char = LP.Character
    if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if hum then hookHum(hum) end
    char.ChildAdded:Connect(function(c)
        if c:IsA("Humanoid") then hookHum(c) end
    end)
end
bindCharacter()
LP.CharacterAdded:Connect(function()
    task.wait(0.5)
    bindCharacter()
end)

RunService.RenderStepped:Connect(function()
    local hum = getHum(LP)
    if not hum then return end
    if cfg.SpeedOn and math.abs(hum.WalkSpeed - cfg.Speed) > 0.05 then hum.WalkSpeed = cfg.Speed end
    if cfg.JumpOn then
        if not hum.UseJumpPower then hum.UseJumpPower = true end
        if math.abs(hum.JumpPower - cfg.Jump) > 0.05 then hum.JumpPower = cfg.Jump end
    end
end)

local function applyMovement()
    local hum = getHum(LP)
    if not hum then return end
    if cfg.SpeedOn then hum.WalkSpeed = cfg.Speed end
    if cfg.JumpOn then
        hum.UseJumpPower = true
        hum.JumpPower = cfg.Jump
    end
end

task.spawn(function()
    while task.wait(0.05) do
        if cfg.InfJump and UIS:IsKeyDown(Enum.KeyCode.Space) then
            local hum = getHum(LP)
            if hum and hum.Health > 0 then
                if hum:GetState() ~= Enum.HumanoidStateType.Jumping then
                    pcall(function() hum:ChangeState(Enum.HumanoidStateType.Jumping) end)
                end
                hum.Jump = true
            end
        end
    end
end)

UIS.JumpRequest:Connect(function()
    if cfg.InfJump then
        local hum = getHum(LP)
        if hum then pcall(function() hum:ChangeState(Enum.HumanoidStateType.Jumping) end) end
    end
end)

