local function makeToggle(parent, text, key, dot, onChange)
    local b = Instance.new("TextButton")
    b.Size = UDim2.new(1, 0, 0, 28)
    b.BackgroundColor3 = C_ROW
    b.BorderSizePixel = 0
    b.Font = Enum.Font.GothamMedium
    b.TextSize = 11
    b.TextXAlignment = Enum.TextXAlignment.Left
    b.TextColor3 = C_TXT
    b.Text = "      " .. text
    b.AutoButtonColor = false
    b.TextTruncate = Enum.TextTruncate.AtEnd
    b.Parent = parent
    Instance.new("UICorner", b).CornerRadius = UDim.new(0, 5)

    local d = Instance.new("Frame")
    d.Size = UDim2.new(0, 6, 0, 6)
    d.Position = UDim2.new(0, 12, 0.5, -3)
    d.BackgroundColor3 = C_GREY
    d.BorderSizePixel = 0
    d.Parent = b
    Instance.new("UICorner", d).CornerRadius = UDim.new(1, 0)

    local pill = Instance.new("Frame")
    pill.Size = UDim2.new(0, 22, 0, 12)
    pill.Position = UDim2.new(1, -32, 0.5, -6)
    pill.BackgroundColor3 = Color3.fromRGB(48, 52, 62)
    pill.BorderSizePixel = 0
    pill.Parent = b
    Instance.new("UICorner", pill).CornerRadius = UDim.new(1, 0)

    local knob = Instance.new("Frame")
    knob.Size = UDim2.new(0, 8, 0, 8)
    knob.Position = UDim2.new(0, 2, 0.5, -4)
    knob.BackgroundColor3 = Color3.fromRGB(190, 196, 206)
    knob.BorderSizePixel = 0
    knob.Parent = pill
    Instance.new("UICorner", knob).CornerRadius = UDim.new(1, 0)

    local hovered = false
    local function refresh()
        local on = cfg[key]
        b.BackgroundColor3 = hovered and C_ROWH or C_ROW
        d.BackgroundColor3 = on and (dot or C_ACC) or C_GREY
        d.BackgroundTransparency = on and 0 or 0.45
        pill.BackgroundColor3 = on and C_ACC or Color3.fromRGB(48, 52, 62)
        knob.Position = on and UDim2.new(1, -10, 0.5, -4) or UDim2.new(0, 2, 0.5, -4)
    end
    b.MouseEnter:Connect(function() hovered = true; refresh() end)
    b.MouseLeave:Connect(function() hovered = false; refresh() end)
    b.MouseButton1Click:Connect(function()
        cfg[key] = not cfg[key]
        refresh()
        if onChange then onChange(cfg[key]) end
    end)
    refresh()
    return b, refresh
end

local function makeSlider(parent, text, key, min, max, step, decimals, onChange)
    local holder = Instance.new("Frame")
    holder.Size = UDim2.new(1, 0, 0, 34)
    holder.BackgroundColor3 = C_ROW
    holder.BorderSizePixel = 0
    holder.Parent = parent
    Instance.new("UICorner", holder).CornerRadius = UDim.new(0, 5)

    local l = Instance.new("TextLabel")
    l.Size = UDim2.new(1, -64, 0, 18)
    l.Position = UDim2.new(0, 12, 0, 3)
    l.BackgroundTransparency = 1
    l.Font = Enum.Font.GothamMedium
    l.TextSize = 11
    l.TextXAlignment = Enum.TextXAlignment.Left
    l.TextColor3 = C_TXT
    l.Text = text
    l.TextTruncate = Enum.TextTruncate.AtEnd
    l.Parent = holder

    local v = Instance.new("TextLabel")
    v.Size = UDim2.new(0, 46, 0, 18)
    v.Position = UDim2.new(1, -54, 0, 3)
    v.BackgroundTransparency = 1
    v.Font = Enum.Font.GothamBold
    v.TextSize = 11
    v.TextXAlignment = Enum.TextXAlignment.Right
    v.TextColor3 = C_ACC
    v.Parent = holder

    local bar = Instance.new("Frame")
    bar.Size = UDim2.new(1, -24, 0, 4)
    bar.Position = UDim2.new(0, 12, 0, 25)
    bar.BackgroundColor3 = Color3.fromRGB(50, 55, 65)
    bar.BorderSizePixel = 0
    bar.Parent = holder
    Instance.new("UICorner", bar).CornerRadius = UDim.new(1, 0)

    local fill = Instance.new("Frame")
    fill.BackgroundColor3 = C_ACC
    fill.BorderSizePixel = 0
    fill.Size = UDim2.new(math.clamp((cfg[key] - min) / (max - min), 0, 1), 0, 1, 0)
    fill.Parent = bar
    Instance.new("UICorner", fill).CornerRadius = UDim.new(1, 0)

    local function fmt(x)
        if decimals then return string.format("%." .. decimals .. "f", x) end
        return tostring(math.floor(x + 0.5))
    end
    local function draw()
        v.Text = fmt(cfg[key])
        fill.Size = UDim2.new(math.clamp((cfg[key] - min) / (max - min), 0, 1), 0, 1, 0)
    end
    draw()

    local dragging = false
    local function set(x)
        local rel = math.clamp((x - bar.AbsolutePosition.X) / math.max(bar.AbsoluteSize.X, 1), 0, 1)
        cfg[key] = math.floor((min + (max - min) * rel) / step + 0.5) * step
        draw()
        if onChange then onChange(cfg[key]) end
    end
    holder.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
            dragging = true; set(i.Position.X)
        end
    end)
    UIS.InputChanged:Connect(function(i)
        if dragging and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then
            set(i.Position.X)
        end
    end)
    UIS.InputEnded:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)
    return holder
end

local function makeChoice(parent, text, key, values, color, onChange)
    local b = Instance.new("TextButton")
    b.Size = UDim2.new(1, 0, 0, 28)
    b.BackgroundColor3 = C_ROW
    b.BorderSizePixel = 0
    b.Font = Enum.Font.GothamMedium
    b.TextSize = 11
    b.TextColor3 = color or C_BLUE
    b.Text = text .. ": " .. tostring(cfg[key])
    b.AutoButtonColor = false
    b.TextTruncate = Enum.TextTruncate.AtEnd
    b.Parent = parent
    Instance.new("UICorner", b).CornerRadius = UDim.new(0, 5)
    b.MouseButton1Click:Connect(function()
        local i = 1
        for k, val in ipairs(values) do if val == cfg[key] then i = k end end
        i = (i % #values) + 1
        cfg[key] = values[i]
        b.Text = text .. ": " .. tostring(cfg[key])
        if onChange then onChange(cfg[key]) end
    end)
    return b
end

