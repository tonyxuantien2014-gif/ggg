              fog = 2600, fogS = 0, shadow = true, tint = Color3.fromRGB(10,14,40),
              c = 0.06, s = -0.3, br = 1.05, stars = 14000, useSky = true },
    Void = { b = 0.12, amb = Color3.fromRGB(4,4,8), oa = Color3.fromRGB(2,2,4), clock = 0,
             fog = 800, fogS = 0, shadow = true, tint = Color3.fromRGB(16,6,28),
             c = 0.14, s = -0.55, br = 1.4, stars = 800, useSky = true },
    Neon = { b = 2.4, amb = Color3.fromRGB(120,80,170), oa = Color3.fromRGB(140,120,180), clock = 19,
             fog = origLight.FogEnd, fogS = origLight.FogStart, shadow = false,
             tint = Color3.fromRGB(30,10,40), c = 0.08, s = 0.32, br = 1.22, stars = 0, useSky = false },
}
local function applyShader(name)
    local p = presets[name] or presets.None
    cfg.Shader = name
    Lighting.Brightness = p.b; Lighting.Ambient = p.amb
    Lighting.OutdoorAmbient = p.oa; Lighting.ClockTime = p.clock
    Lighting.FogEnd = p.fog; Lighting.FogStart = p.fogS
    Lighting.GlobalShadows = p.shadow
    cc.TintColor = p.tint; cc.Contrast = p.c; cc.Saturation = p.s; cc.Brightness = p.br
    if p.useSky then
        if not sky or not sky.Parent then
            if sky then sky:Destroy() end
            sky = Instance.new("Sky"); sky.Name = "AimEspSky"; sky.Parent = Lighting
        end
        sky.StarCount = p.stars
    elseif sky then
        sky:Destroy(); sky = nil
    end
end

local function applyExpander()
    local char = LP.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not root then return end
    if cfg.Expander then
        root.Size = Vector3.new(cfg.ExpanderSize, cfg.ExpanderSize, cfg.ExpanderSize)
        root.Transparency = 0.55
    else
        root.Size = Vector3.new(2, 2, 1); root.Transparency = 1
    end
end

